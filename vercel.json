{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "includeFiles": "{app,core,data}/**"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "unr-transparente-sigma.vercel.app"
        }
      ],
      "destination": "https://universidadtransparente.com.ar/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.universidadtransparente.com.ar"
        }
      ],
      "destination": "https://universidadtransparente.com.ar/$1",
      "permanent": true
    }
  ]
}
